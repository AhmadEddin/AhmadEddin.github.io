---
import Base from '../layouts/Base.astro';
---
<Base title="Nothing recorded here" description="This address has no page. The pen is drawing a flat line. Head back to the start to see Ahmad Kamal Eddin’s work.">
  <section class="lost wrap" data-trace="flat">
    <p class="label mono" aria-hidden="true">no signal</p>
    <h1 class="lost__title rise rise--clip" style="--d:0.05s">Nothing recorded here.</h1>
    <p class="lost__text rise" style="--d:0.25s">This address has no page, or the page moved. The pen has nothing to write, so the line stays flat.</p>
    <a class="btn rise" style="--d:0.4s" href="/">Back to the start <span class="btn__arrow" aria-hidden="true">↖</span></a>
  </section>
</Base>

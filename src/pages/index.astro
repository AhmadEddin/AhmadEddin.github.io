---
import Base from '../layouts/Base.astro';
import RecorderFigure from '../components/RecorderFigure.astro';
import { site, projects, facts, experience, skills, spoken } from '../data/site';
---
<Base>
  <div data-home>
    <section class="hero wrap" aria-label="Introduction">
      <p class="hero__scale mono" aria-hidden="true"><span>49.7</span><span>50.0</span><span>50.3 Hz</span></p>
      <h1 class="hero__name">
        <span class="ln ln--1"><span>Ahmad</span></span> <span class="ln ln--2"><span>Kamal</span></span> <span class="ln ln--3"><span>Eddin</span></span>
      </h1>
      <div class="hero__copy rise" style="--d:0.45s">
        <p class="hero__line">{site.hero.line}</p>
        <p class="hero__meta">{site.hero.meta}</p>
      </div>
      <a class="hero__cta btn rise" style="--d:0.6s" href={`mailto:${site.email}`}>Email me <span class="btn__arrow" aria-hidden="true">↗</span></a>
    </section>

    <section class="instrument wrap" aria-labelledby="instrument-title">
      <h2 class="label" id="instrument-title">The instrument</h2>
      <div class="instrument__fig" data-reveal="up"><RecorderFigure /></div>
    </section>

    <section class="statement wrap" aria-labelledby="about">
      <h2 class="label" id="about">About</h2>
      <p class="statement__lead" data-split="lines">{site.statement}</p>
      <p class="statement__body" data-reveal="up">{site.about}</p>
    </section>

    <section class="work wrap" id="work" aria-labelledby="work-title">
      <div class="work__head">
        <h2 class="work__title" id="work-title" data-split="lines">Selected work</h2>
        <p class="work__count mono">{projects.length} events recorded</p>
      </div>
      <ol class="work__list">
        {projects.map((p) => (
          <li class="row" data-event={p.event}>
            <a class="row__link" href={`/work/${p.slug}/`}>
              <span class="row__leader" aria-hidden="true"></span>
              <h3 class="row__title">{p.title}<span class="row__arrow" aria-hidden="true">→</span></h3>
              <p class="row__meta"><b>{p.org}</b>{p.years}</p>
              <p class="row__sum">{p.summary}</p>
              <p class="row__note mono">{p.eventNote}</p>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <section class="facts wrap" aria-labelledby="facts-title">
      <h2 class="label" id="facts-title">In numbers</h2>
      <dl class="facts__list">
        {facts.map((f) => (
          <div class="facts__item" data-reveal="up">
            <dt class="facts__text">{f.label}</dt>
            <dd class="facts__value" style="order:-1">{f.value}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="exp wrap" id="experience" aria-labelledby="exp-title">
      <h2 class="label" id="exp-title">Experience</h2>
      <ol class="exp__list">
        {experience.map((e) => (
          <li class="exp__item" data-event="period">
            <p class="exp__dates">{e.dates}</p>
            <h3 class="exp__org">{e.org}</h3>
            <p class="exp__role">{e.role}</p>
            <p class="exp__text">{e.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="skills wrap" aria-labelledby="skills-title">
      <h2 class="label" id="skills-title">Skills</h2>
      <div class="skills__grid">
        {skills.map((s) => (
          <div class="skills__group">
            <h3>{s.group}</h3>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
      <p class="skills__spoken">Languages: {spoken}</p>
    </section>
  </div>
</Base>
